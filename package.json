{
  "name": "ruffneck-social-hub",
  "version": "3.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/remove-known-stale-content-component.mjs && npm run audit:imports && npm run audit:workflow && npm run audit:saved-replies && npm run audit:sla && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-inbox-workflow.mjs && node scripts/test-saved-replies.mjs && node scripts/test-inbox-sla.mjs && vitest run",
    "audit:imports": "node scripts/audit-internal-imports.mjs",
    "audit:workflow": "node scripts/audit-inbox-workflow.mjs",
    "audit:saved-replies": "node scripts/audit-saved-replies.mjs",
    "audit:sla": "node scripts/audit-inbox-sla.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
