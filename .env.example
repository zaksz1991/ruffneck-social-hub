# Public Supabase browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional canonical URL alias used by billing/callback configuration.
NEXT_PUBLIC_APP_URL=

# Server-only database credential. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local/private OpenAI-compatible inference endpoint (for example Ollama /v1).
# The deployment server must be able to reach this endpoint. A self-hosted model
# avoids a required hosted-AI subscription but still needs compute and operations.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=

# Optional Upstash REST rate limiting / coordination credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta / Instagram Business Login (server-only).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ENABLE_COMMENT_MANAGEMENT=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0

# Facebook Login for Pages (server-only).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=

# Publishing worker (server-only).
SOCIAL_PUBLISH_CRON_SECRET=

# LinkedIn Pages OAuth (server-only).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610

# TikTok Login Kit / Content Posting API (server-only).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_VERIFIED_MEDIA_HOSTS=

# Google OAuth / YouTube Data API v3 + YouTube Analytics API (server-only).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_VERIFIED_MEDIA_HOSTS=
YOUTUBE_MAX_UPLOAD_BYTES=67108864

# WhatsApp Business Cloud API (server-only).
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional ClamAV-compatible scanner. Leave unset to keep inbound media quarantined.
WHATSAPP_MEDIA_SCANNER_URL=
WHATSAPP_MEDIA_SCANNER_TOKEN=

# Flutterwave V3 Public-Key checkout + manual dashboard verification.
# This public key is safe for browser checkout; it cannot verify transactions.
NEXT_PUBLIC_FLW_PUBLIC_KEY=
# Secret hash authenticates incoming webhooks; it does not verify a payment.
FLW_SECRET_HASH=
# Exact allowlisted platform billing administrator email(s), comma-separated.
BILLING_PLATFORM_ADMIN_EMAILS=

# Daily subscription lifecycle cron. Server-only, independent of FLW_SECRET_HASH.
CRON_SECRET=
