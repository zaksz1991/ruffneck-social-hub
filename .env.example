NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only; never expose in NEXT_PUBLIC variables
SUPABASE_SERVICE_ROLE_KEY=
# Optional local/private OpenAI-compatible inference endpoint (for example Ollama /v1).
# The deployment server must be able to reach this endpoint. Use HTTPS for public hosts.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
# Optional bearer token for an authenticated local inference gateway.
LOCAL_AI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Instagram Business Login (server-only; never prefix these with NEXT_PUBLIC_)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Set true only after the Meta app has the comment-management permission configured and approved.
INSTAGRAM_ENABLE_COMMENT_MANAGEMENT=false
# Exactly 32 random bytes encoded as base64, or 64 hexadecimal characters.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Instagram Graph API version (used only by the Instagram integration).
META_GRAPH_API_VERSION=v25.0

# Facebook Login for Pages (server-only; never prefix with NEXT_PUBLIC_).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional Facebook Graph API version; current default in this release is v26.0.
FACEBOOK_GRAPH_API_VERSION=v26.0

# Server-only publishing worker. Never prefix these with NEXT_PUBLIC_.
SOCIAL_PUBLISH_CRON_SECRET=

# Meta webhook verification token shared by Facebook Page and Instagram webhook endpoints (server-only).
# Facebook POST signatures are separately verified with FACEBOOK_APP_SECRET.
META_WEBHOOK_VERIFY_TOKEN=

# LinkedIn Pages OAuth (server-only; organization discovery only in v2.0.0).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn Marketing API version in YYYYMM format; default 202610.
LINKEDIN_API_VERSION=202610
